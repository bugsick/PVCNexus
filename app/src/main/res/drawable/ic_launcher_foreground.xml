<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Central Hexagon / Diamond Nexus Shield -->
    <path
        android:pathData="M54,26 L78,40 L78,68 L54,82 L30,68 L30,40 Z"
        android:strokeWidth="2.5"
        android:strokeColor="#06B6D4">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="30"
                android:startY="26"
                android:endX="78"
                android:endY="82"
                android:type="linear">
                <item android:offset="0.0" android:color="#336366F1" />
                <item android:offset="1.0" android:color="#3306B6D4" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 3-Leg Network Connection Lines -->
    <path
        android:pathData="M54,46 L54,34 M54,54 L40,66 M54,54 L68,66"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:strokeColor="#38BDF8" />

    <!-- Center Node -->
    <path
        android:pathData="M54,54m-6,0a6,6 0 1,1 12,0a6,6 0 1,1 -12,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="48"
                android:startY="48"
                android:endX="60"
                android:endY="60"
                android:type="linear">
                <item android:offset="0.0" android:color="#A855F7" />
                <item android:offset="1.0" android:color="#6366F1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Top Node (Connect) -->
    <path
        android:pathData="M54,34m-4,0a4,4 0 1,1 8,0a4,4 0 1,1 -8,0"
        android:fillColor="#38BDF8" />

    <!-- Bottom Left Node (Grow - Team A) -->
    <path
        android:pathData="M40,66m-4,0a4,4 0 1,1 8,0a4,4 0 1,1 -8,0"
        android:fillColor="#10B981" />

    <!-- Bottom Right Node (Succeed - Team B/C) -->
    <path
        android:pathData="M68,66m-4,0a4,4 0 1,1 8,0a4,4 0 1,1 -8,0"
        android:fillColor="#F59E0B" />

    <!-- Inner Core Dot -->
    <path
        android:pathData="M54,54m-2,0a2,2 0 1,1 4,0a2,2 0 1,1 -4,0"
        android:fillColor="#FFFFFF" />

</vector>
